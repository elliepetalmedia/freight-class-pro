# Netlify headers — caching + security (copied to dist/public/_headers by Vite)
# Static hashed assets: immutable. HTML/prerendered pages: revalidate. Public data: cache 1h.

/assets/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.png
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
/llms.txt
  Cache-Control: public, max-age=3600
/calculator.md
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
